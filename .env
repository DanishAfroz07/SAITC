# Local config only - nothing here is a secret. Edit values directly for
# your machine (different model, port, etc).

# The date the assignment asks us to answer "what is current" as of.
# Change this to move the assistant's notion of "today" without touching code.
AS_OF_DATE=2026-08-27

# --- Paths (relative to project root) ---
DOCUMENTS_DIR=data/documents
MANIFEST_PATH=data/corpus_manifest.json
CHROMA_DIR=chroma
COLLECTION_NAME=cerulean_corpus

# --- Ollama (local model server) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Retrieval / evidence tuning ---
# Every one of these was set from a live test run against real Ollama output,
# not guessed - see the README's "Retrieval and evidence tuning" section for
# the specific failure each number was chosen to fix.
TOP_K=8
SIMILARITY_THRESHOLD=0.62
AMBIGUITY_MARGIN=0.03
AMBIGUITY_MIN_SECTIONS=5
CONFLICT_CONFIDENCE_THRESHOLD=0.70
CHUNK_MAX_CHARS=1200

# --- Retrieval confidence tiers (attached to SUFFICIENT answers only) ---
# This is NOT a "the answer is correct" probability - it's how strongly the
# retrieved evidence matched, nothing more. Calibrated against real scores:
# clean single-topic matches scored 0.73-0.79 live. See README.
HIGH_CONFIDENCE_SCORE=0.78
MEDIUM_CONFIDENCE_SCORE=0.68

# --- Hybrid search (semantic + BM25 keyword) ---
# Implemented (app/retrieval/lexical_search.py, retriever.py:HybridRetriever)
# but OFF by default - tested against the one case it was built for and it
# didn't change the outcome. See README.
HYBRID_SEARCH_ENABLED=false

# --- Reranking ---
# Implemented and tested (app/retrieval/reranker.py) but OFF by default: at
# this corpus's size (13 docs, ~120 chunks) semantic retrieval alone already
# ranks cleanly, so the extra per-query LLM call isn't earning its keep. Flip
# to true to see it work - see README for the reasoning.
RERANK_ENABLED=false
RERANK_TOP_N=4

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
